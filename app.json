{
  "expo": {
    "name": "DayFrame",
    "slug": "day-frame",
    "scheme": "dayframe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jiyonginspace.dayframe",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#EB806D",
          "defaultChannel": "activity-reminders"
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "DayFrame 카드 저장을 위해 사진 접근을 허용해 주세요.",
          "savePhotosPermission": "DayFrame 카드를 사진 앱에 저장하도록 허용해 주세요.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
